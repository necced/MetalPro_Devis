# Cloudflare Pages Headers pour MetalPro Devis PWA
# Optimisation cache, sécurité, PWA

# Service Worker - Pas de cache, scope racine
/sw.js
  Service-Worker-Allowed: /
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript

# Manifest PWA - Cache long (immuable via révision)
/manifest.webmanifest
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/manifest+json

# Workbox runtime - Cache long (noms hashés)
/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript

# Icônes PWA - Cache long
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Page hors-ligne - Pas de cache (toujours fraîche)
/offline.html
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/html

# HTML principal - Pas de cache (SPA, SW gère)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/html

# Assets JS/CSS (hashés par Vite) - Cache long
/assets/js/*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript
/assets/css/*.css
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css

# Sécurité - Headers protecteurs
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# CSP - Restreint mais permet inline styles (Tailwind), SW, et le hash Netlify HUD
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-BkKP2XO6WOEc3kXOiLr2ZoY83hamalKjPY9xBcbXVuw='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:;